+
+def test_f04_t26_an_item_with_a_problem_is_read_with_no_default_unit(folder: DataFolder) -> None:
+    """The amount gives every reason except NO_UNIT, because only the ingredient decides it."""
+    items = (
+        '{ item = "豆瓣酱", amount = "3" }',
