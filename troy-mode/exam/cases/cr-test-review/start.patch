+"""Tests of F04 for read_recipe: the tags and the ingredients (T20 to T26)."""
+
+from dataclasses import replace
+from fractions import Fraction
+
+from f03_support import (
+    M_ITEM_EMPTY,
+    M_ITEM_NOT_A_TABLE,
+    M_ITEM_NOT_A_TEXT,
