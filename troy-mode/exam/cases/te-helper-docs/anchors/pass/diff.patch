@@ -267,7 +261,10 @@ def menu_of(*cells: str, meals: Sequence[Meal] = LUNCH_DINNER, week: int = 48) -
 def every_slot(
     text: str, meals: Sequence[Meal] = EVERY_MEAL, week: int = 48, times: int = 1
 ) -> WeekMenu:
