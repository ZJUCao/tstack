+    row("Sat 21 Nov", f"Tomato and egg noodles {TIMES}2", DASH),
+    row("Sun 22 Nov", DASH, f"Cola chicken wings {TIMES}4"),
+    row("", "", f"Stir-fried choy sum {TIMES}4"),
+    row("", "", f"Steamed rice {TIMES}4"),
