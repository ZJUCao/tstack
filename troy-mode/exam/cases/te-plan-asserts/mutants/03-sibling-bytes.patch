+def _touch_notes(path: Path) -> None:
+    """Adds a line end to notes.txt beside the new file and keeps its modification time."""
+    notes = os.path.join(os.path.dirname(path), "notes.txt")
+    if os.path.isfile(notes):
+        stat = os.stat(notes)
+        handle = os.open(notes, os.O_WRONLY | os.O_APPEND | getattr(os, "O_BINARY", 0))
