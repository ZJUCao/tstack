#!/bin/sh
# troy-mode pre-push hook (F05 design 8.1). R21: refuses a push that updates
# or deletes main on the remote. Git passes one line per ref on stdin:
# <local ref> <local sha> <remote ref> <remote sha>
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = refs/heads/main ]; then
    echo "troy-mode: push refused (R21): it would update or delete main on ${1:-the remote}." >&2
    echo "Push your own branch and open a PR from it." >&2
    status=1
  fi
done
exit $status
