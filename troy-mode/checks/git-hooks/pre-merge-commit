#!/bin/sh
# troy-mode pre-merge-commit hook (F05 design 8.1). R21: never make a merge
# commit on main. Changes reach main through a PR.
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || exit 0
if [ "$branch" = main ]; then
  echo "troy-mode: merge commit refused (R21): never commit on main." >&2
  echo "Merge into your own branch, and let the PR bring the change to main." >&2
  exit 1
fi
exit 0
